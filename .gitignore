# ============================================================
#  .gitignore - the publish whitelist, inverted.
#  Anything listed here can never be added by `git add -A`,
#  so `git add -A && git commit && git push` stays safe.
#  Tracked files are NOT affected: use `git rm --cached` first.
# ============================================================

# --- Secrets / runtime state (per-machine, never publish) ---
* mango/Settings/
*.key
*.token
*.env

# --- Logs and captured screens ---
* mango/Logs/
*.log
_Debug/

# --- Dev-only tree: harness, probes, snapshots, backups ---
# Kept on disk. Never published; use it for test copies instead of branches.
AA-mango-dev/

# --- Build output ---
*.zip
*.7z

# --- OS / editor ---
Thumbs.db
desktop.ini
.vscode/
.idea/
